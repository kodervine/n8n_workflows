      "parameters": {
        "jsCode": "const data = $('Webhook').first().json.body;\n\n// Determine status based on the Paystack event type\nconst status = (data.event === 'charge.success') ? 'Success' : 'Failed';\n\n// Get existing loyalty data (if this node follows a Lookup node)\nlet totalSpent =  $input.first().json['Total Spent']|| 0;\nlet purchaseCount = $input.first().json['Purchase Count'] || 0;\n\nif (status === 'Success') {\n  totalSpent += data.amount;\n  purchaseCount += 1;\n}\n\nreturn {\n  json: {\n    email: data.email,\n    name: data.name,\n    amount: data.amount,\n    status: status,\n    reference: data.reference,\n    date: new Date().toISOString().split('T')[0],\n    totalSpent: totalSpent,\n    purchaseCount: purchaseCount,\n    product: data.product\n  }\n};"
      },
