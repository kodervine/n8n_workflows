      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const raw = item.json.content.parts[0].text.replace(/```json|```/g, \"\");\n  const data = JSON.parse(raw);\n  let score = 10;\n  if (data.linkedin_headline.length > 70) score -= 5;\n  return { json: { ...data, quality_score: score, status: score >= 8 ? \"PASS\" : \"FAIL\" } };\n});"
