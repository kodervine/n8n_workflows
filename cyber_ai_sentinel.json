    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  try {\n    const rawText = item.json.content.parts[0].text;\n    const cleanText = rawText.replace(/```json|```/g, \"\").trim();\n    const cleanData = JSON.parse(cleanText);\n    \n    // Fallback logic to prevent \"undefined\"\n    const source = $(\"Remove Duplicates\").all()[index]?.json || {};\n\n    return {\n      json: {\n        title: source.title || \"Unknown Threat Title\",\n        link: source.link || \"https://cysafepath.com\",\n        summary: cleanData.summary || \"Summary currently being analyzed...\",\n        severity: cleanData.severity || 3,\n        mitigation: cleanData.mitigation || \"Consult internal security policy.\",\n        category: cleanData.category || \"General Security\"\n      }\n    };\n  } catch (e) {\n    return { json: { error: \"Check AI Output Format\", title: \"Data Parsing Error\" } };\n  }\n});"
      },
