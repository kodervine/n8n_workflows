    {
      "parameters": {
        "jsCode": "// This collects every item coming out of the Split Out node\nconst allSplitItems = $input.all(); \n\nconst processedData = [];\n\nfor (const item of allSplitItems) {\n  // 1. Get the subject (Ensure \"subject\" is in \"Fields to Keep\" in Split Out node)\n  const subject = item.json.subject || \"\";\n  \n  // 2. Regex logic\n  const clientMatch = subject.match(/^([^/]+)/);\n  const controlMatch = subject.match(/\\/([^/]+)$/);\n\n  // Access the binary property using bracket notation to avoid Type Errors\n  const binaryObject = item.binary?.data;\n  \n  // Logic: Check if the Base64 'data' property contains the '/Encrypt' flag\n  // 'L0VuY3J5cHQ' is the Base64 signature for encrypted PDFs\n  const isLocked = binaryObject && binaryObject[\"data\"] \n    ? binaryObject[\"data\"].includes('L0VuY3J5cHQ') \n    : false;\n  \n  // 3. Create a new object that includes BOTH json and binary\n  processedData.push({\n    json: {\n      client: clientMatch ? clientMatch[1].trim() : 'Unknown',\n      control_id: controlMatch ? controlMatch[1].trim() : 'Unknown',\n      is_protected: isLocked, // This is your \"Triage\" flag\n      emailId: item.json.id, \n      attachmentName: item.json.name,\n      year: 2026,\n      receivedAt: item.json.date,\n      subject: subject,\n      senderEmail: item.json.from?.value[0]?.address || 'Unknown',\n      senderName: item.json.from?.value[0]?.name || 'Unknown',\n      status: isLocked ? \"Quarantine: Encrypted\" : \"Audit: Verified\"\n    },\n    // IMPORTANT: This line carries the file data to the next node\n    binary: item.binary \n  });\n}\n\nreturn processedData;"
      },
