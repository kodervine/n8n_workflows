      "id": "4978f2e5-0239-404e-8d1a-f9c275c6fdc0",
      "name": "Check for transactions from previous month"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst dateInfo = $('Get Previous Month Report').first().json;\n\nlet successRev = 0;\nlet failedRev = 0;\nlet successCount = 0;\nlet failedCount = 0;\n\n// 1. Process all transactions\nitems.forEach(item => {\n  const amt = parseFloat(item.json.Amount || 0);\n  if (item.json.Status === 'Success') {\n    successRev += amt;\n    successCount++;\n  } else {\n    failedRev += amt;\n    failedCount++;\n  }\n});\n\n// 2. Calculate metrics\nconst totalAttempts = items.length;\nconst successRate = totalAttempts > 0 ? ((successCount / totalAttempts) * 100).toFixed(1) + '%' : '0%';\nconst avgOrderValue = successCount > 0 ? (successRev / successCount) : 0;\n\n// 3. Prepare data for Google Sheets and Gmail\nreturn {\n  json: {\n    // Analytics Sheet Data\n    Month: dateInfo.monthName,\n    Year: dateInfo.year,\n    \"Total Sales\": successRev,\n    \"Failed Revenue\": failedRev,\n    \"Net Profit\": successRev,\n    \"Success Rate\": successRate,\n    \n    // Email Report Data\n    report_date: `${dateInfo.monthName} ${dateInfo.year}`,\n    html_report: `\n<div style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 650px; margin: auto; border: 1px solid #dcdcdc; border-radius: 10px; background-color: #f9f9f9;\">\n    <div style=\"background-color: #2c3e50; padding: 25px; color: #ffffff; border-radius: 10px 10px 0 0;\">\n        <h2 style=\"margin: 0; font-size: 22px;\">Monthly Business Pulse</h2>\n        <p style=\"margin: 5px 0 0; font-size: 14px; opacity: 0.8;\">Summary for ${dateInfo.monthName} ${dateInfo.year}</p>\n    </div>\n    \n    <div style=\"padding: 30px;\">\n        <p>Hello,</p>\n        <p>Here is your performance summary. Our recovery system is actively monitoring all transaction attempts.</p>\n        \n        <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n            <tr>\n                <td style=\"padding: 15px; background-color: #ffffff; border: 1px solid #eeeeee; text-align: center;\">\n                    <span style=\"display: block; font-size: 11px; color: #888; text-transform: uppercase;\">Successful Revenue</span>\n                    <strong style=\"font-size: 18px; color: #27ae60;\">₦${successRev.toLocaleString()}</strong>\n                </td>\n                <td style=\"padding: 15px; background-color: #ffffff; border: 1px solid #eeeeee; text-align: center;\">\n                    <span style=\"display: block; font-size: 11px; color: #888; text-transform: uppercase;\">Failed Revenue (At Risk)</span>\n                    <strong style=\"font-size: 18px; color: #e74c3c;\">₦${failedRev.toLocaleString()}</strong>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding: 15px; background-color: #ffffff; border: 1px solid #eeeeee; text-align: center;\">\n                    <span style=\"display: block; font-size: 11px; color: #888; text-transform: uppercase;\">Success Rate</span>\n                    <strong style=\"font-size: 18px; color: #2c3e50;\">${successRate}</strong>\n                </td>\n                <td style=\"padding: 15px; background-color: #ffffff; border: 1px solid #eeeeee; text-align: center;\">\n                    <span style=\"display: block; font-size: 11px; color: #888; text-transform: uppercase;\">Avg. Order Value</span>\n                    <strong style=\"font-size: 18px; color: #2980b9;\">₦${avgOrderValue.toFixed(2)}</strong>\n                </td>\n            </tr>\n        </table>\n\n        <div style=\"background-color: #fff9db; padding: 15px; border-left: 5px solid #fcc419; margin-top: 20px;\">\n            <p style=\"margin: 0; font-size: 14px; color: #856404;\">\n                <strong>💡 Recovery Insight:</strong> We identified <strong>${failedCount}</strong> failed attempts this month. Our automated rescue system followed up with each one to protect your revenue.\n            </p>\n        </div>\n\n        <p style=\"margin-top: 30px; font-size: 13px; color: #999;\">\n            This report was generated automatically. Your analytics sheet has been updated for ${dateInfo.monthName}.\n        </p>\n    </div>\n</div>`\n  }\n};"
      },
