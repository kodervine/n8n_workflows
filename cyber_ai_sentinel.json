        "jsCode": "const blocks = [\n  {\n    type: \"header\",\n    text: {\n      type: \"plain_text\",\n      text: \"🚀 Daily Competitor & Market Report\"\n    }\n  },\n  { type: \"divider\" }\n];\n\nfor (const item of $json.data || []) {\n  blocks.push(\n    {\n      type: \"section\",\n      text: {\n        type: \"mrkdwn\",\n        text: `*${item.title}*\\n${item.summary}`\n      },\n      accessory: {\n        type: \"button\",\n        text: { type: \"plain_text\", text: \"View Article\" },\n        url: item.link\n      }\n    },\n    {\n      type: \"context\",\n      elements: [\n        {\n          type: \"mrkdwn\",\n          text: `Category: ${item.category} | Importance: ${item.importance ?? \"N/A\"}/5`\n        }\n      ]\n    },\n    { type: \"divider\" }\n  );\n}\n\nreturn [{ json: { blocks } }];\n"
